{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chatgpt-ask-user-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ASK_SESSIONS",
        "class_name": "AskSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-ask-session",
      "new_sqlite_classes": ["AskSession"]
    }
  ]
}
